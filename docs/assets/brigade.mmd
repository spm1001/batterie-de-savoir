flowchart TB
    subgraph session["Session Lifecycle"]
        direction LR
        trousse["Trousse — knife roll\n(incl. consomme, mandoline)"]
        bon["Bon — the ticket"]
        trousse -->|"hooks inject tactical state"| bon
        bon -->|"/open loads bon context"| trousse
    end

    subgraph auth["Infrastructure"]
        jeton["Jeton — the token"]
    end

    subgraph content["Content & Automation"]
        direction LR
        mise["Mise — mise en place"]
        passe["Passe — the pass"]
        mise <-->|"cross-refer: articles vs DOM"| passe
    end

    subgraph memory["Memory"]
        garde["Garde-manger — cold station"]
    end

    subgraph orchestration["Orchestration"]
        aboyeur["Aboyeur — the caller"]
    end

    trousse -->|"handoffs"| garde
    bon -->|"work state"| garde
    aboyeur -->|"spawns workers and reflectors"| session
    aboyeur -->|"reads bon_hash for stuck detection"| bon
    jeton -->|"OAuth credentials"| mise
    mise -->|"deposits to disk"| fs[("Filesystem — shared state")]
    passe -->|"deposits to disk"| fs
    bon -->|".bon/items.jsonl"| fs
    trousse -->|"handoffs/*.md"| fs

    classDef sessionNode fill:#1a1a2e,stroke:#00d9ff,color:#e0e0e0
    classDef contentNode fill:#1a1a2e,stroke:#00c000,color:#e0e0e0
    classDef memoryNode fill:#1a1a2e,stroke:#ff6b6b,color:#e0e0e0
    classDef orchNode fill:#1a1a2e,stroke:#c084fc,color:#e0e0e0
    classDef authNode fill:#1a1a2e,stroke:#34d399,color:#e0e0e0
    classDef fsNode fill:#0d0d1a,stroke:#888,color:#ccc

    class trousse,bon sessionNode
    class mise,passe contentNode
    class garde memoryNode
    class aboyeur orchNode
    class jeton authNode
    class fs fsNode
